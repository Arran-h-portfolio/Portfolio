@page "/projects"
@using GameProject.Models
@inject IJSRuntime JS



<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@* RotaHub Project Demo and maybe screenshots *@

@* Memory Type Game (overall style: retro arcade)*@
@* ----> Container for top screen maybe with animations or current highscore with previous highscore displayed<----*@
@* Screen needs to update when game is finished "Game Over, high score: [score]"*@
<div class="projects-wrapper">
<h2 class="game-heading">Memory Type Game: Work in progress!</h2>

<div class="monitor-wrapper">
    @* <img src="Images/monitor-image.png" alt="retro monitor" class="monitor-img" /> *@
    <div class="monitor-screen">
        @if (game.IsGameOver)
        {
            <div id="game-over-screen">
                <h2 id="game-title">GAME OVER</h2>
                <p id="score-display">Final Score: @game.Score</p>
                <p id="score-display">High Score: @game.HighScore</p>
                <button id="start-button" @onclick="RestartGame">Play Again</button>
            </div>
        }
        else if (!game.IsGameStarted)
        {
            <div id="top-screen">
                <h2 id="game-title">Memory-Type</h2>
                <p class="description-line">Test your memory and typing skills!</p>
                <p class="description-line">Memorize the sentences displayed on the screen.</p>
                <p class="description-line">Type the sentences as quickly and</p>
                <p class="description-line">accurately as you can.</p>
            </div>
            <button id="start-button" @onclick="StartGame">Start Game</button>
        }
        else
        {
            <div id="game-screen">
                <p id="score-display">Memorize the placeholder</p>
                <input id="input-box" class="@(isIncorrect ? "input-incorrect" : "")" type="text"
                       value="@userInput"
                       @oninput="e => userInput = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleEnter"
                       placeholder="@game.CurrentSentence" />
                <p id="score-display">Score: @game.Score</p>
                <p id="score-display">High Score: @game.HighScore</p>
            </div>
        }
    </div>
</div>
</div>
@* PlaceHolder Section for sentences to be typed, held inside a seperate container* *@

@* Start Game button, Finish Game button *@



@* Logic for handling game state and scoring *@
@* - Need stored sentences to be displayed 
-highscore tracker
- Previous Highscore tracker
- tracker for correct sentence typed
- logic for handling game state *@
@code {
    private string userInput = string.Empty;
    private bool isIncorrect = false;
    public MemoryGame game = new MemoryGame()
    {
        // Populate didctionarys for each round with sentences to be typed
        Rounds = new Dictionary<int, Dictionary<int, string>>()
        {
            {
                1, new Dictionary<int, string>()
                {
                    { 1, "You bow to no one" },
                    { 2, "The stars are veiled" },
                    { 3, "Authority is not given to you" },
                    { 4, "Courage will now be your best defence" },
                    { 5, "Hope remains while the company is true" }
                }
            },
            {

                2, new Dictionary<int, string>()
                {
                    { 1, "He is a young man, full of energy and a talent in his own way" },
                    { 2, "All we have to do is to decide what to do with the time that is given to us" },
                    { 3, "The world is full of magic things, patiently waiting for our senses to grow sharper" },
                    { 4, "The only way to do great work is to love what you do" }
                }
            }
        }
    };
    public void StartGame()
    {
        game.IsGameStarted = true;
        game.IsGameOver = false;
        game.CurrentRound = 1;
        game.CurrentSentenceIndex = 1;
        game.Score = 0;
        LoadCurrentSentence();
    }
    private void RestartGame()
    {
        game.IsGameOver = false;
        game.PreviousHighScore = game.HighScore;
        StartGame();
    }
    private void AdvanceRound()
    {
        game.CurrentRound++;
        StateHasChanged();
    }
    private void LoadCurrentSentence()
    {
        var round = game.Rounds![game.CurrentRound];
        if (round.ContainsKey(game.CurrentSentenceIndex))
        {
            game.CurrentSentence = round[game.CurrentSentenceIndex];
        }
    }
    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        
        if (userInput.Trim() == game.CurrentSentence)
        {
            game.Score++;
            game.CorrectSentencesTyped++;
        }
        else
        {
            // Trigger shake
            isIncorrect = true;
            game.Score--;
            StateHasChanged();
            await Task.Delay(400); // Matches animation length
            isIncorrect = false; // resets bool so animations stop and user can try again
            @* return; // don't advance round *@
        }

        game.CurrentSentenceIndex++;
        var round = game.Rounds![game.CurrentRound];

        if (!round.ContainsKey(game.CurrentSentenceIndex))
        {
            game.CurrentRound++;
            game.CurrentSentenceIndex = 1;

            if (!game.Rounds.ContainsKey(game.CurrentRound))
            {
                if (game.HighScore == 0 || game.Score > game.HighScore)
                {
                    game.PreviousHighScore = game.HighScore;
                    game.HighScore = game.Score;
                }
                game.IsGameOver = true;
                game.IsGameStarted = false;
            }
            else{
                LoadCurrentSentence();
            }
        }
        else
        {
            LoadCurrentSentence();
        }

        userInput = string.Empty;
            
        
    }
}



