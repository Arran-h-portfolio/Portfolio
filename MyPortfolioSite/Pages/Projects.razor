@page "/projects"
@using GameProject.Models
@inject IJSRuntime JS



<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@* RotaHub Project Demo and maybe screenshots *@

@* Memory Type Game (overall style: retro arcade)*@
@* ----> Container for top screen maybe with animations or current highscore with previous highscore displayed<----*@
@* Screen needs to update when game is finished "Game Over, high score: [score]"*@
<h2>Memory Type Game: Work in progress!</h2>

<div class="monitor-wrapper">
    <img src="Images/monitor-image.png" alt="retro monitor" class="monitor-img" />
    <div class="monitor-screen">
        <div id="top-screen">
            <h2 id="game-title">Memory Type Game</h2>
            <p id="game-description">Test your memory and typing skills in this fun and addictive game! Try to remember and type the sentences correctly to achieve a high score. Can you beat your previous high score?</p>
            <div id="score-display">
                <p>Current Score: @game.Score</p>
                <p>Previous High Score: @game.PreviousHighScore</p>
            </div>
        </div>
        <div id="game-screen">
            @* This is where the sentences will be displayed for the player to type *@
            <p id="sentence-display"><input /></p>
        </div>
    </div>
</div>
