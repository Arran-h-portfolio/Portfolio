    @* Contact Section Content, need icons linking to LinkedIn, Instagram, Github, and an email link *@
    <div class="container text-center">
        <h2 class="mb-4">Contact Me</h2>
        <div class="social-icons">
            <a href="https://www.instagram.com/devbyarran/" target="_blank" class="social-icon">
                <i class="fab fa-instagram"></i>
            </a>
            <a href="https://github.com/Arran-h-portfolio" target="_blank" class="social-icon">
                <i class="fab fa-github"></i>
            </a>
            <a href="mailto:ahprospects@outlook.com" class="social-icon">
                <i class="fas fa-envelope"></i>
            </a>
        </div>
    </div>
</section>
