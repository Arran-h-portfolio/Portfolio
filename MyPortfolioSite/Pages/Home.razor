@page "/"

<PageTitle>Home</PageTitle>

@* Home Top Section - Introduction *@
<section id="home" class="hero-section">
    @* Hero Section Content, need photo(circular) + name + title + tagline + 2 cta buttons *@
    <img src="images/profile.jpg" alt="Profile Image" class="rounded-circle" />
    <h1 class="display-4 mt-3">Arran Hewitson</h1>
    <p class="lead">Aspiring .NET Developer | Passionate about building impactful software solutions</p>
    <div class="mt-4">
        <a href="#about" class="btn btn-primary btn-lg me-3">Learn More</a>
        <a href="#projects" class="btn btn-outline-light btn-lg">View Projects</a>
    </div>
</section>

@* About Section *@
<section id="about" class="about-section py-5">
    @* About Section Content, need brief bio + 2-3 key highlights (e.g. education, certifications, key skills) *@
    <div class="container">
        <h2 class="mb-4">About Me</h2>
        <p class="lead">Aspiring Software Developer/Engineer with a foundation in the .Net ecosystem,
             including experience building applications using Blazor and MAUI Blazor.
              Skilled in C#, VSCode, and version control using Git and Github.
               Developing multiple project-based applications through self-directed learning and online courses.
               Eager to contribute to a development team and continue growing as a software engineer in a professional environment.
        </p>
    </div>
</section>
